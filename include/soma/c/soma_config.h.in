/* The build of the C API: generated by CMake from soma_config.h.in. */

#ifndef SOMA_C_SOMA_CONFIG_H_
#define SOMA_C_SOMA_CONFIG_H_

/** 1 when SOMA was built with MPI: soma_comm_create takes an MPI_Comm. */
#define SOMA_C_HAVE_MPI @SOMA_C_HAVE_MPI@
/** Bytes of a local id (soma_lo_t) and of a CSR offset (soma_offset_t). */
#define SOMA_C_LO_BYTES @SOMA_C_LO_BYTES@
#define SOMA_C_OFFSET_BYTES @SOMA_C_OFFSET_BYTES@

#endif /* SOMA_C_SOMA_CONFIG_H_ */

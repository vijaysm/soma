@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(SOMA_ENABLE_MPI @SOMA_ENABLE_MPI@)
set(SOMA_ENABLE_HDF5 @SOMA_ENABLE_HDF5@)
set(SOMA_LO_64 @SOMA_LO_64@)
set(SOMA_OFFSET_64 @SOMA_OFFSET_64@)
set(SOMA_ENABLE_KOKKOSKERNELS @SOMA_ENABLE_KOKKOSKERNELS@)
set(SOMA_ENABLE_ARBORX @SOMA_ENABLE_ARBORX@)
set(SOMA_ENABLE_PETSC @SOMA_ENABLE_PETSC@)
# "installed" or "fetched", as configured; fetched means Kokkos was installed
# alongside SOMA, into this prefix.
set(SOMA_KOKKOS_SOURCE "@SOMA_KOKKOS_SOURCE@")

# Replay the AppleClang libomp fallback this install was configured with, so
# find_dependency(Kokkos) -> find_dependency(OpenMP) succeeds for consumers.
if("@SOMA_APPLE_OPENMP_MANUAL@" AND NOT OpenMP_CXX_FOUND)
  set(OpenMP_CXX_FLAGS "-Xpreprocessor;-fopenmp" CACHE STRING "" FORCE)
  set(OpenMP_CXX_LIB_NAMES "omp" CACHE STRING "" FORCE)
  set(OpenMP_omp_LIBRARY "@SOMA_LIBOMP_LIBRARY@" CACHE FILEPATH "" FORCE)
  set(OpenMP_CXX_INCLUDE_DIR "@SOMA_LIBOMP_INCLUDE_DIR@" CACHE PATH "" FORCE)
  find_package(OpenMP COMPONENTS CXX QUIET)
  if(TARGET OpenMP::OpenMP_CXX)
    set_property(TARGET OpenMP::OpenMP_CXX APPEND PROPERTY
      INTERFACE_INCLUDE_DIRECTORIES "@SOMA_LIBOMP_INCLUDE_DIR@")
  endif()
endif()

# The Kokkos installed alongside SOMA must win over any other Kokkos on the
# consumer's search path (it has the backends and ABI SOMA was built with).
if(SOMA_KOKKOS_SOURCE STREQUAL "fetched" AND NOT Kokkos_DIR)
  set(Kokkos_DIR "${PACKAGE_PREFIX_DIR}/lib/cmake/Kokkos" CACHE PATH
    "Kokkos installed alongside SOMA" FORCE)
endif()
find_dependency(Kokkos 5.0)
if(SOMA_ENABLE_MPI)
  find_dependency(MPI COMPONENTS CXX)
endif()
if(SOMA_ENABLE_KOKKOSKERNELS)
  if(NOT KokkosKernels_DIR AND NOT "@KokkosKernels_DIR@" STREQUAL "")
    set(KokkosKernels_DIR "@KokkosKernels_DIR@")
  endif()
  find_dependency(KokkosKernels)
endif()
if(SOMA_ENABLE_ARBORX)
  if(NOT ArborX_DIR AND NOT "@ArborX_DIR@" STREQUAL "")
    set(ArborX_DIR "@ArborX_DIR@")
  endif()
  find_dependency(ArborX)
endif()
# The PETSc SOMA was built with, found again through its pkg-config file. A
# consumer that has found PETSc itself keeps its PkgConfig::PETSC.
if(SOMA_ENABLE_PETSC AND NOT TARGET PkgConfig::PETSC)
  find_dependency(PkgConfig)
  set(_soma_pkg_config_path "$ENV{PKG_CONFIG_PATH}")
  set(ENV{PKG_CONFIG_PATH} "@SOMA_PETSC_PKGCONFIG_DIR@:$ENV{PKG_CONFIG_PATH}")
  pkg_check_modules(PETSC REQUIRED IMPORTED_TARGET PETSc>=3.19)
  set(ENV{PKG_CONFIG_PATH} "${_soma_pkg_config_path}")
endif()
# The static library links HDF5 privately; consumers still link it.
if(SOMA_ENABLE_HDF5)
  if(NOT HDF5_ROOT AND NOT DEFINED ENV{HDF5_ROOT} AND NOT "@SOMA_HDF5_ROOT@" STREQUAL "")
    set(HDF5_ROOT "@SOMA_HDF5_ROOT@")
  endif()
  find_dependency(HDF5 COMPONENTS C)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/somaTargets.cmake")
check_required_components(soma)

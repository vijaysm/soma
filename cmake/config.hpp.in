#ifndef SOMA_CONFIG_HPP_
#define SOMA_CONFIG_HPP_

// Generated by CMake. Records options that change the ABI or public headers.

#define SOMA_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define SOMA_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define SOMA_VERSION_PATCH @PROJECT_VERSION_PATCH@

#cmakedefine01 SOMA_ENABLE_MPI
#cmakedefine01 SOMA_LO_64
#cmakedefine01 SOMA_OFFSET_64
#cmakedefine01 SOMA_DEBUG
#cmakedefine01 SOMA_ENABLE_KOKKOSKERNELS
#cmakedefine01 SOMA_ENABLE_PETSC

// Compile-time default for passing device buffers to MPI. The transport layer
// also honours the environment variable SOMA_GPU_AWARE_MPI=0|1 at runtime, so
// GPU-aware MPI can be turned off for debugging without rebuilding.
#define SOMA_GPU_AWARE_MPI_DEFAULT @SOMA_GPU_AWARE_MPI_DEFAULT@

// 1 for a build configured with SOMA_REPRODUCIBLE=ON: compiled with the flags
// that keep floating-point arithmetic as written (no a * b + c becomes a
// fused multiply-add, on the host or on the device). The run-time switch
// soma::reproducible() is separate and starts off in every build.
#define SOMA_REPRODUCIBLE_BUILD @SOMA_REPRODUCIBLE_BUILD@

#endif  // SOMA_CONFIG_HPP_

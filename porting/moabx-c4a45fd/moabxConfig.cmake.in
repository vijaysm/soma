@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(MOABX_ENABLE_MPI @PP_ENABLE_MPI@)
set(MOABX_ENABLE_OPENMP @PP_ENABLE_OPENMP@)
set(MOABX_HAS_MOAB @MOABX_HAS_MOAB@)
set(MOABX_INDEX_64 @MOABX_INDEX_64@)
set(MOABX_PP_BACKEND @MOABX_PP_BACKEND@)

if(MOABX_ENABLE_MPI)
  find_dependency(MPI COMPONENTS CXX)
endif()

if(MOABX_ENABLE_OPENMP)
  # An OpenMP build of MOABX can still be consumed by a project that resolves
  # OpenMP differently, so a miss here is not fatal.
  find_package(OpenMP COMPONENTS CXX QUIET)
endif()

if(MOABX_HAS_MOAB)
  find_dependency(MOAB)
endif()

# The backend is baked into the installed headers, so a consumer needs the
# same one available.
if(MOABX_PP_BACKEND STREQUAL "kokkos")
  # Kokkos's config calls find_dependency(OpenMP) when built with the OpenMP
  # device. AppleClang cannot satisfy FindOpenMP unaided, so replay the
  # settings this install was configured with rather than making every
  # consumer rediscover them.
  if(NOT OpenMP_CXX_FOUND AND "@PP_OPENMP_MANUAL@")
    # FindOpenMP treats this as a raw flag string, so the SHELL: prefix used
    # on target properties must not appear here.
    set(OpenMP_CXX_FLAGS "@PP_OPENMP_FIND_FLAGS@" CACHE STRING "" FORCE)
    set(OpenMP_CXX_LIB_NAMES "omp" CACHE STRING "" FORCE)
    set(OpenMP_omp_LIBRARY "@PP_OPENMP_LIBRARY@" CACHE FILEPATH "" FORCE)
    set(OpenMP_CXX_INCLUDE_DIR "@PP_OPENMP_INCLUDE_DIR@" CACHE PATH "" FORCE)
    find_package(OpenMP COMPONENTS CXX QUIET)
  endif()
  find_dependency(Kokkos)
elseif(MOABX_PP_BACKEND STREQUAL "eigen")
  find_dependency(Eigen3 3.3 NO_MODULE)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/moabxTargets.cmake")

check_required_components(moabx)
